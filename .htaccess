# Bloquea acceso público al historial de git (expuesto al clonar el repo directo en public_html)
RedirectMatch 404 /\.git

# Bloquea archivos internos que no son parte del sitio publico
<FilesMatch "^(gas-contacto\.js|PRODUCT\.md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# BL-166: el sitio no devolvía headers de seguridad propios; lo único que
# llegaba era el upgrade-insecure-requests que inyecta el hosting. LiteSpeed
# (Hostinger) lee estas directivas igual que Apache.
#
# Al ser HTML estático no hay nonce por request como en Sector y Content Hub,
# así que la CSP en enforce lista el hash sha256 de cada script inline. Ese
# bloque lo genera tools/gen-csp.py: después de tocar cualquier <script> inline
# hay que volver a correrlo, si no el script deja de ejecutarse en silencio.
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # Sin `preload`: eso se envía al registro de Chrome y no se revierte a voluntad.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    # --- script-src generado por tools/gen-csp.py — no editar a mano ---
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://connect.facebook.net 'sha256-0DRjH1ebgLr5wix2u3HXk4HRCjpo9FbTZwg2wBWTpVI=' 'sha256-7XIygu2OoQsnwbSzazVzu5MiKvuAtoIWWNQHxUxBGzc=' 'sha256-A0R2S+OzaUNa+5HDOkbIpQlgu1AWleqsSnFWltpQmmg=' 'sha256-D5c1wpQM+sK+27lC05siCemBd+SEh19q/l16DvaT8CM=' 'sha256-FdVGVbU5ekiZ/CsxcF42HcE0wv7+oqrsFGVgf6+Rrio=' 'sha256-Ps13n2qzgmtpRs2xg1+JlzaJkIgZ9/3kKAStQekS4NE=' 'sha256-S80dNuDFYuZ4W2jZa+rMIITZqxv4pN87Mo9WL7loiaE=' 'sha256-SgxFbGStfWhyqmoRsFxZtYqofRG55GW2WEt1YzcySd0=' 'sha256-VilVJKa7sBS3emBaxb0r2x/m0ZoNUWNBnBF/v5BLbAg=' 'sha256-Yls+OIzVX3hjPIOwZVxNcXfrzdUBnxABuIOtBMzuOdA=' 'sha256-ZfPgbjZjghBlQWBB7j5bqXaoGt4hCrApA9Qv0UbiefQ=' 'sha256-aTIZT9QXUEHuV/0BP+ZT9rWp5+SoHdFkMKTGPycZszg=' 'sha256-asujriyUpFXA+zzYTbzQHyPdzl5O4L4IMEpbdKCWt50=' 'sha256-azL8wF1Y/VI9HtnqUP1eCu0YCw6WK659N3YwwztyUgw=' 'sha256-fntxoeQiix3DZfkWjCMrUq7fU/FYCVmpfyjGSDpaRHc=' 'sha256-ieiQEhvwANuOiuAS4REY75ZzrSJuJlMM/CO64canjRI='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com https://connect.facebook.net https://www.facebook.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    # --- fin del bloque generado ---
</IfModule>
